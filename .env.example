# Copie para .env.local (já ignorado pelo git). Nunca commite segredos.

# Preço e modo do Mercado Pago
PRICE_BRL=20
MP_MODE=production

# Credenciais do Mercado Pago — só em .env.local ou no painel da Vercel.
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=

# Opcional. Se definido, o webhook também exige o cabeçalho x-signature.
# Sem isto, cada notificação é autenticada buscando o pagamento
# em GET /v1/payments/{id} com o access token.
# MP_WEBHOOK_SECRET=

# URL pública deste site, sem barra no final.
# Em produção, a URL *.vercel.app (ou o domínio que você escolher).
# NEXT_PUBLIC_SITE_URL=https://exemplo.vercel.app
# SITE_URL=https://exemplo.vercel.app

# Site do i-Tools, só para links.
ITOOLS_URL=https://i-tools.shop

# Segredos de assinatura (obrigatórios em produção). Gere com: openssl rand -hex 32
# SESSION_SECRET=
# DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_TOKEN_TTL_HOURS=24
DOWNLOAD_MAX_COUNT=5

# Instalador: URL privada. O site baixa no servidor e entrega ao comprador
# — essa URL nunca vai ao navegador.
# YAMI_INSTALLER_URL=
# YAMI_INSTALLER_AUTH_HEADER=
# YAMI_INSTALLER_FILENAME=YAMI-Setup-0.62.0.exe
# YAMI_INSTALLER_PATH=
YAMI_VERSION=0.62.0

# Banco. Em produção na Vercel, use um Postgres (Neon/Supabase, faixa gratuita).
# Sem DATABASE_URL, a Vercel cai em memória (pedidos não sobrevivem a um restart).
# DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_PATH=data/yami.db

# E-mail da licença (Resend). Desligado se vazio.
# RESEND_API_KEY=
# EMAIL_FROM=

# Relé do painel remoto: memory (dev / este processo), ably ou pusher
# (a interface existe; o adaptador gerenciado ainda não está ligado).
RELAY_PROVIDER=memory
# ABLY_API_KEY=
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=

# Blob privado dos instaladores (a Vercel preenche ao conectar o store).
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# O manifesto vive no Blob (releases/manifest.json) e, se houver banco, na tabela release_manifest.
# Para publicar um novo build: npm run publish-release -- --setup FILE --portable FILE [--apk FILE] --version X.Y.Z
